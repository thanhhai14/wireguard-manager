# Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: npm run hash-password -- is intentionally not provided; see README.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash

# Generate both values with: openssl rand -base64 32
SESSION_SECRET=replace_with_at_least_32_random_bytes
DATA_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# Optional. Defaults to 8 hours and 180 seconds.
SESSION_TTL_HOURS=8
PEER_ONLINE_THRESHOLD_SECONDS=180
